{
  // file level
  "Docker Compose Service": {
    "prefix": [
      "df",
      "docker-service"
    ],
    "body": [
      "name: \"${1:${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}}_${2:${TM_FILENAME_BASE/^([^\\.]+).*/$1/}}\"",
      "",
      "volumes:",
      "# use cnlv for a new volume snippet",
      "# use celv for an existing volume snippet",
      "",
      "networks: ",
      "# use cnln for a new network snippet",
      "# use celn for an existing network snippet",
      "",
      "services:",
      "# use info for a new service(info section) snippet",
      "",
    ],
    "description": "Docker Compose with group_folder + filename base snippet"
  },
  // file level: volume
  "compose new local volume": {
    "prefix": [
      "cnlv",
      "composenewlocalvolume"
    ],
    "body": [
      "\t$1_data:",
      "\t\tname: \"${3:${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}}_${2:${TM_FILENAME_BASE/^([^\\.]+).*/$1/}}_${1:app}_volume\"",
      "\t\tdriver: local",
      "\t\tdriver_opts:",
      "\t\t\tdevice: \\$DATA_DIR/$3/$2/$1/",
      "\t\t\to: bind",
      "\t\t\ttype: local",
      ""
    ],
    "description": "A high level docker compose/swarm volume snippet to create a new volume"
  },
  "compose existing local volume": {
    "prefix": [
      "celv",
      "composeexistinglocalvolume"
    ],
    "body": [
      "\t$1_data:",
      "\t\tname: \"${3:${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}}_${2:${TM_FILENAME_BASE/^([^\\.]+).*/$1/}}_${1:app}_volume\"",
      "\t\texternal: true",
      ""
    ],
    "description": "A high level docker compose/swarm volume snippet to connect and existing volume"
  },
  // file level: network
  "compose new local network": {
    "prefix": [
      "cnln",
      "composenewlocalnetwork"
    ],
    "body": [
      "\t$1_network:",
      "\t\tname: \"${2:${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}}_${1:${TM_FILENAME_BASE/^([^\\.]+).*/$1/}}_network\"",
      "\t\t# attachable: true",
      "\t\t# driver: bridge",
      "\t\t# enable_ipv4: true",
      "\t\t# enable_ipv6: true",
      "\t\t# labels:",
      "\t\t\t#$1.$2.description: \"Description of the network\"",
      ""
    ],
    "description": "A high level docker compose/swarm network snippet to create a new network"
  },
  "compose existing local network": {
    "prefix": [
      "celn",
      "composeexistinglocalnetwork"
    ],
    "body": [
      "\t$1_network:",
      "\t\tname: \"${3:${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}}_${2:${TM_FILENAME_BASE/^([^\\.]+).*/$1/}}_${1:app}_network\"",
      "\t\texternal: true",
      ""
    ],
    "description": "A high level docker compose/swarm network snippet to connect to existing networks"
  },
  // service level
  // service level: informative
  "docker service init/info section": {
    "prefix": [
      "init",
      "info",
      "dcsinfo",
      "serviceinfo",
      "initservice"
    ],
    "body": [
      "",
      "\t$1:",
      "\t\t# info",
      "\t\timage: \"${5:custom_image}:${6:latest}\"",
      "\t\tcontainer_name: \"${8:${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}}_${7:${TM_FILENAME_BASE/^([^\\.]+).*/$1/}}_${1:app}\"",
      "\t\thostname: \"$1_$7_$8\"",
      "\t\tdomainname: \"$1.${2:example.com}\"",
      "\t\taliases:",
      "\t\t\t- \"$1.$7.$8\"",
      "\t\t\t- \"$1.$2\"",
      "\t\tdescription: \"${3:A generic description for the service}\"",
      "\t\tlabels:",
      "\t\t\tcom.portainer.infra.commin.description: \"$3\"",
      "\t\t\tcom.portainer.infra.commin.justification: \"${4:justification for this service}\"",
      ""
    ],
    "description": "The informative section for the service, common for compose+swarm"
  },
  // service level: control
  "docker service control section": {
    "prefix": [
      "control",
      "dcscontrol",
      "servicecontrol"
    ],
    "body": [
      "",
      "\t\t# control",
      "\t\tprivileged: ${1|true,false|}",
      "\t\trestart: ${2|no,always,on-failure,on-failure:3,unless-stopped|}",
      "\t\t#entrypoint: /some/entrypoint/file.sh",
      "\t\t#command: echo \"some example command to run on container start\"",
      "\t\tdepends_on:",
      "\t\t\t${3:app2}:",
      "\t\t\t\tcondition: ${4|service_started,service_healthy,service_completed_successfully|}",
      "\t\t\t\trestart: ${5|true,false|}",
      "\t\t\t\trequired: ${6|true,false|}",
      ""
    ],
    "description": "The control section for the service, common for compose+swarm"
  },
  // service level: environment
  "docker service environment section": {
    "prefix": [
      "env",
      "dcsenv",
      "serviceenv"
    ],
    "body": [
      "",
      "\t\t# environment",
      "\t\tenv_file: ",
      "\t\t\t- \\$SECRETS_DIR/${3:${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}}/${2:${TM_FILENAME_BASE/^([^\\.]+).*/$1/}}/${1:$CLIPBOARD}.env",
      "\t\t#recommended to use env_file",
      "\t\t#environment:",
      "\t\t\t#- ENV_VAR=value",
      ""
    ],
    "description": "The environment section for the service, common for compose+swarm"
  },
  // service level: networking
  "docker service network section": {
    "prefix": [
      "net",
      "dcsnet",
      "servicenet"
    ],
    "body": [
      "",
      "\t\t# network",
      "\t\tnetwork_mode: ${3|none,host,service:_name,container:_name|}",
      "\t\tnetworks:",
      "\t\t\t- ${5:${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}}_${4:${TM_FILENAME_BASE/^([^\\.]+).*/$1/}}_network",
      "\t\tports:",
      "\t\t\t- \"${1:expose_port}:${2:internal_port}\"",
      "\t\texpose:",
      "\t\t\t- \"$2\"",
      "\t\tdns:",
      "\t\t\t- \"1.1.1.1\"",
      "\t\t\t- \"8.8.8.8\"",
      "\t\tlinks:",
      "\t\t\t- ${6: app2_name}",
      ""
    ],
    "description": "The networking section for the service, common for compose+swarm"
  },
  // service level: storage
  "docker service storage section": {
    "prefix": [
      "store",
      "dcsstore",
      "servicestore"
    ],
    "body": [
      "",
      "\t\t# Storage",
      "\t\tstorage_opts:",
      "\t\t\tsize: \"${1:limits(1G,256MB)}\"",
      "\t\tvolumes:",
      "\t\t\t- ${5:${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}}_${4:${TM_FILENAME_BASE/^([^\\.]+).*/$1/}}_${3:$CLIPBOARD}_data:${2:internal/localtion}",
      ""
    ],
    "description": "The storage section for the service, common for compose+swarm"
  },
  // service level: logs
  "docker service health section": {
    "prefix": [
      "logs",
      "health",
      "dcslogs",
      "dcshealth",
      "servicelogs",
      "servicehealth"
    ],
    "body": [
      "",
      "\t\t# health",
      "\t\tattach: ${1|true,false|}",
      "\t\thealthcheck:",
      "\t\t\ttest: [${2:\"CMD-SHELL\", \"curl -f http://localhost/ || exit 1\"}]",
      "\t\t\tinterval: ${3:1m}",
      "\t\t\ttimeout: ${4:10s}",
      "\t\t\tretries: ${5:3}",
      "\t\t\tstart_period: ${6:1m}",
      "\t\tlogging:",
      "\t\t\t# refer here for more info https://docs.docker.com/engine/logging/configure/",
      "\t\t\tdriver: ${7|json-file,local,syslog|}",
      "\t\t\toptions:",
      "\t\t\t\tmax-size: 10m",
      "\t\t\t\tmax-file: 3",
      ""
    ],
    "description": "The health section for the service, common for compose+swarm"
  },
  // service level: hardware
  "docker service hardware section": {
    "prefix": [
      "hw",
      "dcshw",
      "servicehw"
    ],
    "body": [
      "",
      "\t\t# hardware",
      "\t\tcpu_count: ${1:0.5}",
      "\t\tcpu_percent: ${2:100}",
      "\t\tmem_limit: ${3:512M}",
      "\t\tmem_reservation: ${4:256M}",
      ""
    ],
    "description": "The hardware section for the service, common for compose+swarm"
  },
  // service level: capabilities
  "docker service capabilities section": {
    "prefix": [
      "cap",
      "dcscap",
      "servicecap"
    ],
    "body": [
      "",
      "\t\t# capabilities",
      "\t\t#  https://man7.org/linux/man-pages/man7/capabilities.7.html",
      "\t\tcap_add:",
      "\t\t\t- ${1:ALL}",
      "\t\tcap_drop:",
      "\t\t\t- ${2:ALL}",
      ""
    ],
    "description": "The capabilities section for the service, common for compose+swarm"
  },
  // service level: control > swarm
  "docker swarm deploy section": {
    "prefix": [
      "swarm",
      "deploy",
      "dcsswarm",
      "dcsdeploy",
      "servicedeploy",
      "serviceswarm"
    ],
    "body": [
      "",
      "\t\t# swarm",
      "\t\t# https://docs.docker.com/reference/compose-file/deploy/",
      "\t\tdeploy:",
      "\t\t\tendpoint_mode: ${1|vip,dnsrr|}",
      "",
      "\t\t\tmode:",
      "\t\t\t\treplicated:",
      "\t\t\t\t\treplicas: ${2|2}",
      "\t\t\t\tglobal: ${3|true,false|}",
      "",
      "\t\t\tplacement:",
      "\t\t\t\tconstraints:",
      "\t\t\t\t\t- node.role == ${4|manager,worker|}",
      "",
      "\t\t\t#labels:",
      "\t\t\t#paste them from the info section",
      "",
      "\t\t\tresources:",
      "\t\t\t\tlimits:",
      "\t\t\t\t\tcpus: ${5:0.5}",
      "\t\t\t\t\tmemory: ${6:512M}",
      "\t\t\t\treservations:",
      "\t\t\t\t\tcpus: ${7:0.5}",
      "\t\t\t\t\tmemory: ${8:512M}",
      "",
      "\t\t\trestart_policy:",
      "\t\t\t\tcondition: ${9|none,on-failure,any|}",
      "\t\t\t\tdelay: ${10:5s}",
      "\t\t\t\tmax_attempts: ${11:5}",
      "\t\t\t\twindow: ${12:120s}",
      "",
      "\t\t\trollback_config:",
      "\t\t\t\t parallelism: ${13:0}",
      "\t\t\t\t delay: ${14:0s}",
      "\t\t\t\t failure_action: ${15|continue,pause|}",
      "\t\t\t\t monitor: ${16:0}",
      "\t\t\t\t max_failure_ratio: ${17:0}",
      "\t\t\t\t order: ${18|stop-first,start-first|}",
      "",
      "\t\t\tupdate_config:",
      "\t\t\t\tparallelism: ${19:0}",
      "\t\t\t\tdelay: ${20:0s}",
      "\t\t\t\tfailure_action: ${21|continue,pause|}",
      "\t\t\t\tmonitor: ${22:0}",
      "\t\t\t\tmax_failure_ratio: ${23:0}",
      "\t\t\t\torder: ${24|stop-first,start-first|}",
      ""
    ],
    "description": "The swarm deploy section for the service, only applicable to swarm files"
  }
}
