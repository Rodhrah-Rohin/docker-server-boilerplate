{
	// file level: volume
	"swarm new local volume": {
		"prefix": [
			"nlv",
			"snlv",
			"swarmnewlocalvolume"
		],
		"body": [
			"\t$1_data:",
			"\t\tname: \"${3:${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}}_${2:${TM_FILENAME_BASE/^([^\\.]+).*/$1/}}_${1:app}_swarm_volume\"",
			"\t\tdriver: local",
			"\t\tdriver_opts:",
			"\t\t\tdevice: \\$DATA_DIR/swarm/$3/$2/$1/",
			"\t\t\to: bind",
			"\t\t\ttype: local",
			""
		],
		"description": "A high level docker swarm volume snippet to create a new volume"
	},
	"swarm existing local volume": {
		"prefix": [
			"elv",
			"selv",
			"composeexistinglocalvolume"
		],
		"body": [
			"\t$1_data:",
			"\t\tname: \"${3:${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}}_${2:${TM_FILENAME_BASE/^([^\\.]+).*/$1/}}_${1:app}_swarm_volume\"",
			"\t\texternal: true",
			""
		],
		"description": "A high level docker swarm volume snippet to connect and existing volume"
	},
	// file level: network
	"swarm new local network": {
		"prefix": [
			"nln",
			"snln",
			"swarmnewlocalnetwork"
		],
		"body": [
			"\t$1_network:",
			"\t\tname: \"${2:${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}}_${1:${TM_FILENAME_BASE/^([^\\.]+).*/$1/}}_swarm_network\"",
			"\t\t# attachable: true",
			"\t\t# driver: bridge",
			"\t\t# enable_ipv4: true",
			"\t\t# enable_ipv6: true",
			"\t\t# labels:",
			"\t\t\t#$1.$2.description: \"Description of the network\"",
			""
		],
		"description": "A high level docker swarm network snippet to create a new network"
	},
	"swarm existing local network": {
		"prefix": [
			"eln",
			"seln",
			"swarmexistinglocalnetwork"
		],
		"body": [
			"\t$1_network:",
			"\t\tname: \"${3:${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}}_${2:${TM_FILENAME_BASE/^([^\\.]+).*/$1/}}_${1:app}_swarm_network\"",
			"\t\texternal: true",
			""
		],
		"description": "A high level docker swarm network snippet to connect to existing networks"
	},
	// service level
	// service level: environment
	"docker swarm environment section": {
		"prefix": [
			"env",
			"dcsenv",
			"serviceenv"
		],
		"body": [
			"",
			"\t\t# environment",
			"\t\tenv_file: ",
			"\t\t\t- \\$SECRETS_DIR/swarm/${3:${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}}/${2:${TM_FILENAME_BASE/^([^\\.]+).*/$1/}}/${1:$CLIPBOARD}.env",
			"\t\t#recommended to use env_file",
			"\t\t#environment:",
			"\t\t\t#- ENV_VAR=value",
			""
		],
		"description": "The environment section for the service for swarm"
	},
	// service level: networking
	"docker swarm network section": {
		"prefix": [
			"net",
			"dcsnet",
			"servicenet"
		],
		"body": [
			"",
			"\t\t# network",
			"\t\tnetwork_mode: ${3|none,host,service:_name,container:_name|}",
			"\t\tnetworks:",
			"\t\t\t- ${5:${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}}_${4:${TM_FILENAME_BASE/^([^\\.]+).*/$1/}}_swarm_network",
			"\t\tports:",
			"\t\t\t- \"${1:expose_port}:${2:internal_port}\"",
			"\t\texpose:",
			"\t\t\t- \"$2\"",
			"\t\tdns:",
			"\t\t\t- \"1.1.1.1\"",
			"\t\t\t- \"8.8.8.8\"",
			"\t\tlinks:",
			"\t\t\t- ${6: app2_name}",
			""
		],
		"description": "The networking section for the service for swarm"
	},
	// service level: storage
	"docker swarm storage section": {
		"prefix": [
			"store",
			"dcsstore",
			"servicestore"
		],
		"body": [
			"",
			"\t\t# Storage",
			"\t\tstorage_opts:",
			"\t\t\tsize: \"${1:limits(1G,256MB)}\"",
			"\t\tvolumes:",
			"\t\t\t- ${5:${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}}_${4:${TM_FILENAME_BASE/^([^\\.]+).*/$1/}}_${3:$CLIPBOARD}_swarm_data:${2:internal/localtion}",
			""
		],
		"description": "The storage section for the service for swarm"
	},
	// service level: control > swarm
	"docker swarm deploy section": {
		"prefix": [
			"swarm",
			"deploy",
			"dcsswarm",
			"dcsdeploy",
			"servicedeploy",
			"serviceswarm"
		],
		"body": [
			"",
			"\t\t# swarm",
			"\t\t# https://docs.docker.com/reference/compose-file/deploy/",
			"\t\tdeploy:",
			"\t\t\tendpoint_mode: ${1|vip,dnsrr|}",
			"",
			"\t\t\tmode:",
			"\t\t\t\treplicated:",
			"\t\t\t\t\treplicas: ${2|2}",
			"\t\t\t\tglobal: ${3|true,false|}",
			"",
			"\t\t\tplacement:",
			"\t\t\t\tconstraints:",
			"\t\t\t\t\t- node.role == ${4|manager,worker|}",
			"",
			"\t\t\t#labels:",
			"\t\t\t#paste them from the info section",
			"",
			"\t\t\tresources:",
			"\t\t\t\tlimits:",
			"\t\t\t\t\tcpus: ${5:0.5}",
			"\t\t\t\t\tmemory: ${6:512M}",
			"\t\t\t\treservations:",
			"\t\t\t\t\tcpus: ${7:0.5}",
			"\t\t\t\t\tmemory: ${8:512M}",
			"",
			"\t\t\trestart_policy:",
			"\t\t\t\tcondition: ${9|none,on-failure,any|}",
			"\t\t\t\tdelay: ${10:5s}",
			"\t\t\t\tmax_attempts: ${11:5}",
			"\t\t\t\twindow: ${12:120s}",
			"",
			"\t\t\trollback_config:",
			"\t\t\t\t parallelism: ${13:0}",
			"\t\t\t\t delay: ${14:0s}",
			"\t\t\t\t failure_action: ${15|continue,pause|}",
			"\t\t\t\t monitor: ${16:0}",
			"\t\t\t\t max_failure_ratio: ${17:0}",
			"\t\t\t\t order: ${18|stop-first,start-first|}",
			"",
			"\t\t\tupdate_config:",
			"\t\t\t\tparallelism: ${19:0}",
			"\t\t\t\tdelay: ${20:0s}",
			"\t\t\t\tfailure_action: ${21|continue,pause|}",
			"\t\t\t\tmonitor: ${22:0}",
			"\t\t\t\tmax_failure_ratio: ${23:0}",
			"\t\t\t\torder: ${24|stop-first,start-first|}",
			""
		],
		"description": "The swarm deploy section for the service"
	}
}
